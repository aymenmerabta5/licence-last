DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# E2E runs should use an isolated database.
# Use E2E_DATABASE_URL in .env.e2e (preferred) so tests never target your dev DB.
# E2E_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_E2E
# Set only for disposable non-local E2E databases.
# E2E_ALLOW_NON_LOCAL_DATABASE_RESET=0
BETTER_AUTH_SECRET=CHANGE_ME_MIN_32_CHARS
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
AI_API_KEY=CHANGE_ME_FOR_AI_FEATURES
RESEND_API_KEY=CHANGE_ME_FOR_AUTH_EMAILS
EMAIL_FROM=no-reply@example.com
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://your-storage-endpoint
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_PUBLIC_URL=https://cdn.example.com
S3_REGION=auto
# Optional extra origins for Better Auth (comma-separated)
# BETTER_AUTH_TRUSTED_ORIGINS=

# AI
# Gateway-first settings
# AI_PROVIDER=gateway
# AI_MODEL=openai/gpt-4o-mini
# AI_ALLOWED_MODELS=openai/gpt-4o-mini,openai/gpt-4o
# AI_BASE_URL=https://ai-gateway.vercel.sh/v1
#
# Legacy Poe compatibility settings
# AI_PROVIDER=poe
# POE_API_KEY=
# POE_MODEL=
# POE_ALLOWED_MODELS=GPT-5.2,GPT-4o,GPT-4o-mini
# POE_BASE_URL=https://api.poe.com/v1
# ARCADE_API_KEY=

# Alternate S3-compatible naming (compat with other projects)
# Required in production only if you choose these names instead of the S3_* set above.
# S3_BUCKET_NAME=
# NEXT_PUBLIC_S3_ENDPOINT=
# NEXT_PUBLIC_S3_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Redis (Optional - for rate limiting)
# REDIS_URL=redis://localhost:6379
# REDIS_RATE_LIMIT_ENABLED=false

# Feature flags
# FEATURE_NOTIF_PREFERENCES=true
# FEATURE_SAVED_OFFERS=true
# FEATURE_INTERVIEWS=true
# FEATURE_LANGUAGE_REQUIREMENTS=true
# NEXT_PUBLIC_FEATURE_NOTIF_PREFERENCES=true
# NEXT_PUBLIC_FEATURE_SAVED_OFFERS=true
# NEXT_PUBLIC_FEATURE_INTERVIEWS=true
# NEXT_PUBLIC_FEATURE_LANGUAGE_REQUIREMENTS=true

# Logging
# LOG_LEVEL=info

# Cloudflare Turnstile (Optional - CAPTCHA bot protection)
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Production Deployment (docker-compose.prod.yml) ─────────
# These are only needed when deploying with Docker Compose.

# PostgreSQL container credentials
# POSTGRES_USER=stag
# POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# POSTGRES_DB=stag

# Full image reference for the app container.
# The CD workflow updates this automatically to the exact GHCR digest on deploy.
# For a manual first deploy, use `:latest`.
# APP_IMAGE=ghcr.io/your-username/your-repo:latest

# Domain name for Caddy auto-HTTPS (e.g., stag.example.com)
# DOMAIN_NAME=stag.example.com
# BETTER_AUTH_TRUSTED_ORIGINS=https://stag.example.com,https://www.stag.example.com

# First deploy only: seed the database with initial data
# RUN_SEED=false
# Super-admin seed is skipped unless BOTH values below are provided.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=CHANGE_ME
# University-admin seed is skipped unless BOTH values below are provided.
# It links to University Of Constantine 2 by default.
# SEED_UNIVERSITY_ADMIN_EMAIL=admin@univ-constantine2.dz
# SEED_UNIVERSITY_ADMIN_PASSWORD=CHANGE_ME
# SEED_UNIVERSITY_ADMIN_UNIVERSITY_NAME=University Of Constantine 2
