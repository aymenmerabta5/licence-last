DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BETTER_AUTH_SECRET=CHANGE_ME_MIN_32_CHARS
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# AI (Phase 1)
# POE_API_KEY=
# POE_MODEL=
# POE_ALLOWED_MODELS=claude-opus-4.6,gpt-5.2,kimi-k2.5
# POE_BASE_URL=
# ARCADE_API_KEY=

# Optional (email)
# RESEND_API_KEY=
# EMAIL_FROM=

# Optional (S3-compatible storage - AWS S3 / Cloudflare R2 / etc.)
# Primary naming (this repo)
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=
# S3_REGION=auto

# Alternate naming (compat with other projects)
# S3_BUCKET_NAME=
# NEXT_PUBLIC_S3_ENDPOINT=
# NEXT_PUBLIC_S3_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Redis (Optional - for rate limiting)
# REDIS_URL=redis://localhost:6379
# REDIS_RATE_LIMIT_ENABLED=false

# Logging
# LOG_LEVEL=info

# ─── Production Deployment (docker-compose.prod.yml) ─────────
# These are only needed when deploying with Docker Compose.

# PostgreSQL container credentials
# POSTGRES_USER=internex
# POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# POSTGRES_DB=internex

# GitHub repo for container image (e.g., username/internex)
# GITHUB_REPO=your-username/your-repo

# Domain name for Caddy auto-HTTPS (e.g., internex.example.com)
# DOMAIN_NAME=internex.example.com

# First deploy only: seed the database with initial data
# RUN_SEED=false
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=CHANGE_ME
