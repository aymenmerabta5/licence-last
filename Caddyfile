# Caddy reverse proxy for Next.js behind Cloudflare Proxy
# Cloudflare SSL/TLS mode must be set to "Full" in the dashboard
{$DOMAIN_NAME:localhost} {
	# Self-signed cert — Cloudflare "Full" mode accepts this
	tls internal

	encode zstd gzip

	# Cache immutable Next.js static assets (1 year)
	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy app:3000
	}

	# All other requests → Next.js
	handle {
		reverse_proxy app:3000 {
			# Always tell Next.js the original request was HTTPS (Cloudflare terminates SSL)
			header_up X-Forwarded-Proto https
		}
	}

	log {
		output file /data/logs/access.log {
			roll_size 25MiB
			roll_keep 3
		}
	}
}
