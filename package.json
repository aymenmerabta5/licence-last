{
  "name": "licence-last",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "analyze:turbopack": "next experimental-analyze",
    "lint": "biome lint . && node scripts/check-import-aliases.cjs && node scripts/check-next-parity.cjs && node scripts/check-navigation-imports.cjs",
    "lint:biome": "biome lint .",
    "lint:fix": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "lint:imports": "node scripts/check-import-aliases.cjs",
    "lint:next-parity": "node scripts/check-next-parity.cjs",
    "lint:architecture": "node scripts/check-feature-folder.cjs",
    "lint:rtl-logical": "node scripts/check-rtl-logical.cjs",
    "lint:animations": "node scripts/check-animation-imports.cjs",
    "lint:i18n-strings": "node scripts/check-i18n-strings.cjs",
    "lint:server-only": "node scripts/check-server-only.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.cjs",
    "test:watch": "bun test --watch",
    "test:coverage": "node scripts/run-coverage.cjs",
    "test:e2e": "PLAYWRIGHT_REUSE_SERVER=1 bun --env-file=.env.e2e x playwright test",
    "test:e2e:visual": "PLAYWRIGHT_REUSE_SERVER=1 bun --env-file=.env.e2e x playwright test --project=visual",
    "test:ci": "node scripts/run-tests.cjs",
    "check:all": "bun run lint && bun run lint:architecture && bun run lint:rtl-logical && bun run lint:animations && bun run lint:server-only && bun run typecheck && bun run test && bun run build",
    "db:generate": "bun run db:generate:dev",
    "db:generate:dev": "bun --env-file=.env.development x --bun drizzle-kit generate",
    "db:generate:prod": "bun --env-file=.env.production x --bun drizzle-kit generate",
    "db:migrate": "bun run db:migrate:dev",
    "db:migrate:dev": "bun --env-file=.env.development x --bun drizzle-kit migrate",
    "db:migrate:prod": "bun --env-file=.env.production x --bun drizzle-kit migrate",
    "db:push": "bun run db:push:dev",
    "db:push:dev": "bun --env-file=.env.development x --bun drizzle-kit push",
    "db:push:prod": "bun --env-file=.env.production x --bun drizzle-kit push --strict",
    "db:studio": "bun run db:studio:dev",
    "db:studio:dev": "bun --env-file=.env.development x --bun drizzle-kit studio",
    "db:studio:prod": "bun --env-file=.env.production x --bun drizzle-kit studio",
    "db:reset": "bun run db:reset:dev",
    "db:reset:dev": "bun --env-file=.env.development run src/server/db/reset.ts",
    "db:reset:prod": "bun --env-file=.env.production run src/server/db/reset.ts --require-production-confirmation",
    "db:seed": "bun run db:seed:dev",
    "db:seed:dev": "bun --env-file=.env.development run src/server/db/seed.ts",
    "mcp:dev": "bun --env-file=.env.development run src/server/mcp/index.ts --mcp-dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.26",
    "@ai-sdk/react": "^3.0.80",
    "@arcadeai/arcadejs": "^2.2.0",
    "@aws-sdk/client-s3": "^3.990.0",
    "@base-ui/react": "^1.1.0",
    "@marsidev/react-turnstile": "^1.4.2",
    "@orpc/client": "^1.13.4",
    "@orpc/experimental-ratelimit": "^1.13.5",
    "@orpc/openapi": "^1.13.5",
    "@orpc/server": "^1.13.4",
    "@orpc/tanstack-query": "^1.13.4",
    "@orpc/zod": "^1.13.5",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-email/components": "^1.0.7",
    "@react-email/render": "^2.0.4",
    "@react-email/tailwind": "^2.0.4",
    "@react-pdf/renderer": "^4.3.2",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/qrcode": "^1.5.6",
    "ai": "^6.0.78",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dejavu-fonts-ttf": "^2.37.3",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.9.3",
    "lucide-react": "^0.563.0",
    "motion": "^12.33.0",
    "next": "^16.2.1",
    "next-intl": "^4.8.2",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.1",
    "server-only": "^0.0.1",
    "shadcn": "^3.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "^1.3.8",
    "drizzle-kit": "^0.31.9",
    "happy-dom": "^20.5.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
