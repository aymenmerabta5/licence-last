{
  "name": "licence-last",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:unit": "bun test src/lib src/server",
    "test:api": "bun test src/app/api",
    "test:pages": "bun test src/app",
    "test:e2e": "bunx playwright test",
    "test:ci": "bun run test:unit && bun run test:api && bun run test:pages",
    "db:generate": "bun run db:generate:dev",
    "db:generate:dev": "bun --env-file=.env.development x --bun drizzle-kit generate",
    "db:generate:prod": "bun --env-file=.env.production x --bun drizzle-kit generate",
    "db:migrate": "bun run db:migrate:dev",
    "db:migrate:dev": "bun --env-file=.env.development x --bun drizzle-kit migrate",
    "db:migrate:prod": "bun --env-file=.env.production x --bun drizzle-kit migrate",
    "db:push": "bun run db:push:dev",
    "db:push:dev": "bun --env-file=.env.development x --bun drizzle-kit push",
    "db:push:prod": "bun --env-file=.env.production x --bun drizzle-kit push --strict",
    "db:studio": "bun run db:studio:dev",
    "db:studio:dev": "bun --env-file=.env.development x --bun drizzle-kit studio",
    "db:studio:prod": "bun --env-file=.env.production x --bun drizzle-kit studio",
    "db:reset": "bun run db:reset:dev",
    "db:reset:dev": "bun --env-file=.env.development run src/server/db/reset.ts",
    "db:reset:prod": "bun --env-file=.env.production run src/server/db/reset.ts",
    "db:seed": "bun run db:seed:dev",
    "db:seed:dev": "bun --env-file=.env.development run src/server/db/seed.ts",
    "mcp:dev": "bun --env-file=.env.development run src/server/mcp/index.ts --mcp-dev"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.26",
    "@ai-sdk/react": "^3.0.80",
    "@arcadeai/arcadejs": "^2.2.0",
    "@base-ui/react": "^1.1.0",
    "@orpc/client": "^1.13.4",
    "@orpc/experimental-ratelimit": "^1.13.5",
    "@orpc/openapi": "^1.13.5",
    "@orpc/server": "^1.13.4",
    "@orpc/tanstack-query": "^1.13.4",
    "@orpc/zod": "^1.13.5",
    "@react-email/components": "^1.0.7",
    "@react-email/render": "^2.0.4",
    "@react-email/tailwind": "^2.0.4",
    "@react-pdf/renderer": "^4.3.2",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-form": "^1.28.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@types/qrcode": "^1.5.6",
    "ai": "^6.0.78",
    "better-auth": "^1.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "ioredis": "^5.9.3",
    "lucide-react": "^0.563.0",
    "motion": "^12.33.0",
    "next": "16.1.6",
    "next-intl": "^4.8.2",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.1",
    "server-only": "^0.0.1",
    "shadcn": "^3.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",

    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "babel-plugin-react-compiler": "^1.0.0",
    "bun-types": "^1.3.8",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "happy-dom": "^20.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
